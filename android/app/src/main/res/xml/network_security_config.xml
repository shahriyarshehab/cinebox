<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext HTTP connections globally for BDIX mother servers & local networks -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">172.16.50.14</domain>
        <domain includeSubdomains="true">172.16.50.7</domain>
        <domain includeSubdomains="true">172.16.50.12</domain>
        <domain includeSubdomains="true">172.16.50.4</domain>
        <domain includeSubdomains="true">172.16.50.2</domain>
        <domain includeSubdomains="true">172.16.50.1</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">github.io</domain>
        <domain includeSubdomains="true">raw.githubusercontent.com</domain>
    </domain-config>
</network-security-config>
